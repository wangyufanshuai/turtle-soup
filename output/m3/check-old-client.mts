import assert from 'node:assert/strict';
import {readFileSync,writeFileSync} from 'node:fs';
import {validateSaveEnvelope as oldValidate} from '../v212/legacy-runtime-2967346/packages/mystery-core/src/save-envelope.ts';
import {validateSaveEnvelope, type CaseFile} from '../../packages/mystery-core/src/index.ts';
import {createRuntimeWorkerHandler} from '../../apps/web/workers/runtime-handler.ts';
const file=JSON.parse(readFileSync('content/zh/cases/c01-cold-room-knock.json','utf8')) as CaseFile;
let response:any;
const worker=createRuntimeWorkerHandler({proofRevision:'m3',investigationRevision:'m2',questionLanguageRevision:'m01',loadCase:async()=>file,postMessage:r=>response=r});
await worker({id:1,type:'initialize',caseId:file.id});
await worker({id:2,type:'command',command:{type:'set_theory_note',revision:'m2',theoryId:'theory-a',text:'合成测试草稿，不是真人存档。'}});
const save=response.save, before=JSON.stringify(save), current=validateSaveEnvelope(save), previous=oldValidate(save);
assert.equal(current.ok,true);
assert.equal(previous.ok,false);
assert.equal(JSON.stringify(save),before);
const report={createdAt:new Date().toISOString(),oldRef:'29673463024b036d9ad7eeb1aeba6973113f635a',schemaVersion:save.schemaVersion,currentAccepted:current.ok,oldRejected:!previous.ok,originalUnchanged:true,oldResult:previous,scope:'Independent old validator rejects M3 commands without mutating the new save. Core-only check, not browser import.'};
writeFileSync('output/m3/old-client.json',JSON.stringify(report,null,2));
console.log(JSON.stringify(report));
