import assert from 'node:assert/strict';
import { readFileSync, writeFileSync } from 'node:fs';
import { createHash } from 'node:crypto';
import { applyPresentationPatch, applyQuestionAliasPack, projectPlayerState, replayCommands, type CaseFile, type RuntimeState } from '../../packages/mystery-core/src/index.ts';
import { selectPresentationPatches, selectHistoricalQuestionRoutingContexts } from '../../tools/generate-content-registry.ts';
import { QUESTION_ALIAS_PACKS } from '../../apps/web/.generated/question-alias-registry.ts';
import { createRuntimeWorkerHandler } from '../../apps/web/workers/runtime-handler.ts';
const root=process.cwd();
const old='output/v212/v212-2026-09-06T10-08-11-942Z-f54095c9/historical-save-oracle/old-generated/';
const hash=(bytes:Buffer|string)=>createHash('sha256').update(bytes).digest('hex');
const index=JSON.parse(readFileSync(old+'oracle-index.json','utf8'));
assert.equal(index.pinnedRef,'29673463024b036d9ad7eeb1aeba6973113f635a');
const read=(ref:{path:string;sha256:string})=>{const bytes=readFileSync(old+ref.path);assert.equal(hash(bytes),ref.sha256);return JSON.parse(bytes.toString('utf8'));};
function semantic(file:CaseFile,state:RuntimeState) {
  const ids=file.events.map(e=>e.id);
  const handles=projectPlayerState(file,{...state,theoryDrafts:[{...state.theoryDrafts[0],eventIds:ids}]}).theoryDrafts[0].eventIds;
  assert.equal(new Set(handles).size,ids.length);
  const map=new Map(handles.map((id,i)=>[id,ids[i]]));
  const decode=(id:string)=>{assert.ok(map.has(id));return map.get(id)!;};
  const game=(g:RuntimeState['game'])=>Object.fromEntries(Object.entries(g).map(([k,v])=>[k,Array.isArray(v)?[...v].sort():v]));
  return {game:game(state.game),transcript:state.transcript.map(t=>({id:t.id,rawQuestion:t.rawQuestion,answerCode:t.answerCode,repeated:t.repeated})),
    evidenceStates:state.evidenceStates,theoryDrafts:state.theoryDrafts.map(d=>({id:d.id,hypothesisId:d.hypothesisId,eventIds:d.eventIds,evidenceIds:[...d.evidenceIds].sort(),motiveKey:d.motiveKey??null})),
    activeTheoryId:state.activeTheoryId,pendingInterpretation:state.pendingInterpretation??null,
    lastQuestionSnapshot:state.lastQuestionSnapshot?{game:game(state.lastQuestionSnapshot.game),transcriptLength:state.lastQuestionSnapshot.transcriptLength}:null,
    solved:state.solved,replayBeatIds:state.replayBeatIds,acceptedCommandCount:state.acceptedCommandCount,unlockedChapterIds:[...state.unlockedChapterIds].sort(),
    reasoningBoards:Object.fromEntries(Object.entries(state.reasoningBoards).map(([id,d])=>{const board=file.reasoningBoards![Number(id.match(/^board-(\d+)$/)![1])-1];
      return [board.id,{placements:Object.fromEntries(Object.entries(d.placements).map(([slot,item])=>[board.slots[Number(slot.match(/^slot-(\d+)$/)![1])-1].id,decode(item)])),
        connections:d.connections.map(c=>({fromEventId:decode(c.fromItemId),toEventId:decode(c.toItemId),relation:c.relation})).sort((a,b)=>JSON.stringify(a).localeCompare(JSON.stringify(b),'en'))}];})),replayMode:state.replayMode};
}
const results=[];
for(const fixture of [...index.fixtures,...index.negatives]) {
  const save=read(fixture.raw),oracle=read(fixture.oracle);
  const id=fixture.caseId;
  const base=JSON.parse(readFileSync(`content/zh/cases/${id}.json`,'utf8')) as CaseFile;
  const file={...applyQuestionAliasPack(applyPresentationPatch(base,selectPresentationPatches(root,'v2.12-m2-dev',[id]).get(id)),QUESTION_ALIAS_PACKS[id]),questionLanguageRevision:'m01' as const,investigationRevision:'m2' as const};
  const contexts=selectHistoricalQuestionRoutingContexts(root,'v2.12-m2-dev',[id]);
  let response:any;
  const handler=createRuntimeWorkerHandler({investigationRevision:'m2',questionLanguageRevision:'m01',loadCase:async()=>file,historicalQuestionRoutingContexts:contexts,postMessage:r=>{response=r;}});
  await handler({id:1,type:'initialize',caseId:id,save});
  if(index.negatives.includes(fixture)) {
    assert.equal(response.restoreStatus,'corrupt');assert.equal(response.persistenceBlocked,true);
  } else {
    const replay=replayCommands(file,save.commands,{historicalQuestionRoutingContexts:contexts[id]});
    assert.deepEqual(semantic(file,replay.state),oracle.expected);
    assert.equal(response.restoreStatus,'restored');
    assert.deepEqual(response.projection,projectPlayerState(file,replay.state));
  }
  assert.equal(hash(readFileSync(old+fixture.raw.path)),fixture.raw.sha256);
  results.push({caseId:id,name:fixture.name,passed:true,rawSha256:fixture.raw.sha256,oracleSha256:fixture.oracle.sha256,negative:index.negatives.includes(fixture)});
}
const report={date:new Date().toISOString(),source:'Existing byte-pinned v2.11 runtime generated fixtures; expectations not regenerated by M2. Core semantic oracle plus production Worker restore. Not human saves or UI playthroughs.',passed:true,valid:index.fixtures.length,negative:index.negatives.length,cases:new Set(index.fixtures.map((f:any)=>f.caseId)).size,results};
writeFileSync('output/m2/historical-replay.json',JSON.stringify(report,null,2)+'\n');
console.log(JSON.stringify({passed:report.passed,valid:report.valid,negative:report.negative,cases:report.cases}));
